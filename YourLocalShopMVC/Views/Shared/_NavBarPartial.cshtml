@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User) && User.IsInRole("Staff"))
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Accounts" asp-page="">Account Management</a>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Shop" asp-action="ViewCart">Shopping Cart</a>
    </li>
}
<li class="nav-item">
    <a class="nav-link text-dark" asp-controller="Shop" asp-action="Orders">Orders</a>
</li>

