@using Microsoft.AspNetCore.Identity
@model IEnumerable<YourLocalShopMVC.Models.Item>
@inject SignInManager<IdentityUser> SignInManager
@inject RoleManager<IdentityRole> RoleManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Your Local Shop";
}

<h1>Your Local Shop</h1>

<p>
    @if (SignInManager.IsSignedIn(User) && User.IsInRole("Staff"))
    {
        <a asp-action="Create">Create New</a>
    }
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Stock)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Stock)
            </td>
            <td>
                @{await Html.RenderPartialAsync("_ItemInputPartial", item.Id);}
            </td>
        </tr>
}
    </tbody>
</table>
