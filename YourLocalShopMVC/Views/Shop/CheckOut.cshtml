@using Microsoft.AspNetCore.Identity
@model YourLocalShopMVC.Models.ShoppingCart
@inject SignInManager<CustomerAccount> SignInManager
@inject RoleManager<IdentityRole> RoleManager
@inject UserManager<CustomerAccount> UserManager

@{
    ViewData["Title"] = "Checkout";
}

<h1>Shopping Cart, Total Cost: $ @Model.TotalCost</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Contents.Keys.First().Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Contents.Keys.First().Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Contents.Keys.Count)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Contents.Keys)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Price)
                </td>
                <td>
                    @Html.DisplayFor(model => model.Contents[item])
                </td>
                <td>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                        </li>
                    </ul>
                </td>
            </tr>
        }
    </tbody>
</table>
<a asp-controller="Shop" asp-action="Order">Commit to purchase</a>

